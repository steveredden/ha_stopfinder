        "name": "/gps",
        "func": "const route = \"gps\";\nconst clientId = msg.payload[0].studentSchedules[0].clientId;\nconst dataSourceId = msg.payload[0].studentSchedules[0].dataSourceId;\n\nlet currentTime = new Date();\nlet hours = currentTime.getHours();\nlet whichTrip = (hours < 10) ? 0 : 1;  //to school vs from school\n\n\nconst busNumber = msg.payload[0].studentSchedules[0].trips[whichTrip].busNumber;\nconst query = `groupName=${clientId}_${dataSourceId}_${busNumber}`;\n\nmsg.headers = msg.authHeaders;\n\nmsg.url = `${msg.uri}/${route}?${query}`;\n\nreturn msg;",
